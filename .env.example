# Copy this file to .env and fill in your values. Never share .env.

# Qryptive user that receives the magic link
LOGIN_EMAIL=your.email@example.com

# Mailbox of that user (Gmail: imap.gmail.com + an App Password)
MAIL_HOST=imap.gmail.com
MAIL_USER=your.email@example.com
MAIL_PASSWORD=your-app-password

# Only for Scenario 2 (optional)
MAGIC_LINK=

# Report email after each run (uses MAIL_USER + MAIL_PASSWORD to send)
REPORT_TO=
SEND_REPORT_EMAIL=true

# PostgreSQL (test results)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Qryptive
DB_USER=postgres
DB_PASSWORD=your_password
SAVE_RESULTS_TO_DB=true

# Project + artifact storage (used by the database layer)
PROJECT_KEY=QRYPTIVE
PROJECT_NAME=Qryptive
ARTIFACT_DIR=artifacts
DB_POOL_MAX=10
RETRIES=0
