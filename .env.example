# Copy this file to .env and fill in your values. Never share .env.

# Qryptive user that receives the magic link
LOGIN_EMAIL=your.email@example.com

# Mailbox of that user (Gmail: imap.gmail.com + an App Password)
MAIL_HOST=imap.gmail.com
MAIL_USER=your.email@example.com
MAIL_PASSWORD=your-app-password

# Only for Scenario 2 (optional)
MAGIC_LINK=

# Report email after each run (uses MAIL_USER + MAIL_PASSWORD to send)
REPORT_TO=
SEND_REPORT_EMAIL=true

# PostgreSQL (test results)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Qryptive
DB_USER=postgres
DB_PASSWORD=your_password
# true for cloud databases (Neon, Supabase, RDS), false for a local PostgreSQL
DB_SSL=false
SAVE_RESULTS_TO_DB=true

# Project + artifact storage (used by the database layer)
PROJECT_KEY=QRYPTIVE
PROJECT_NAME=Qryptive
ARTIFACT_DIR=artifacts
DB_POOL_MAX=10
RETRIES=0

# ─── GitHub repo scan test (tests/RepoScanTest.spec.ts, tag @reposcan) ───
# GitHub classic PAT with scopes: repo, workflow, delete_repo
SCAN_GITHUB_TOKEN=
# User or organization where the temporary test repo is created
SCAN_GITHUB_OWNER=maulikpatel-SDET
# Qryptive API key (Code Sources > Your API key) - added as PQC_API_KEY secret in the repo
PQC_API_KEY=
# Zip with the code to push (crypto code, so the scan has findings)
SCAN_REPO_ZIP=test-data/scan-repo.zip
SCAN_REPO_PRIVATE=true
SCAN_TIMEOUT_MIN=15
SCAN_MIN_FINDINGS=1
# Expected scan results (hand-written from the zip code) - compared with the Last Scan page
SCAN_EXPECTED_CSV=test-data/scan-repo.expected-findings.csv
# true = keep the test repo in Qryptive and on GitHub after the run (to look at it)
SCAN_KEEP_REPO=false
# Repo whose Last Scan is checked by repositories-last-scan.spec.ts (empty = last repo created by the scan test)
SCAN_RESULTS_REPO=
