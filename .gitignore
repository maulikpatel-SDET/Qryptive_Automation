# ─── Dependencies ───────────────────────────────────────────
node_modules/

# ─── Secrets / environment (commit .env.example only) ──────
.env
.env.*
!.env.example

# ─── Auth sessions (contain login cookies/tokens) ──────────
auth/session-*.json
auth/*.json
!auth/*.example.json

# ─── Test output (generated on every run) ───────────────────
reports/*
logs/*
screenshots/*
screenshots-history/
artifacts/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.trace.zip
*.webm

# Keep empty folders tracked
!**/.gitkeep

# ─── Build output ───────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Logs & debug files ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Local databases / dumps ────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump

# ─── Editor / IDE ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Claude Code local settings ─────────────────────────────
.claude/settings.local.json

# ─── Misc ───────────────────────────────────────────────────
coverage/
.cache/
*.tmp
